# Melooha AI Environment Configuration

# Database (Leave default for local SQLite or provide Postgres URL from Neon/Supabase)
DATABASE_URL=sqlite:///./melooha.db
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Primary LLM: Google Gemini API (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq API (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# App settings
DEBUG=False
ENABLE_OFFLINE_DEMO=True
